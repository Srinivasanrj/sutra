# Copy this file to .env and change what you need.

# Where Ollama is running
SUTRA_OLLAMA_URL=http://localhost:11434

# Main model and a fast model for sub-agents.
# qwen3:4b is smarter but needs about 5 GB of free RAM; qwen3:1.7b is fast on a laptop CPU.
SUTRA_MODEL=qwen3:1.7b
SUTRA_FAST_MODEL=qwen3:1.7b

# Let qwen3 "think" before answering (better answers, much slower on CPU)
SUTRA_THINK=false

# Context window in tokens (bigger = more memory and slower on CPU)
SUTRA_NUM_CTX=8192

# Safety limit: maximum tool-call rounds per request
SUTRA_MAX_STEPS=25
